// Lauwak accounts: signup / login / logout / me.
// Passwords are hashed with scrypt (built into Node). Sessions are random
// tokens in an httpOnly cookie. Data is kept in server/data/*.json.
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");

const DATA_DIR = path.join(__dirname, "data");
const USERS_FILE = path.join(DATA_DIR, "users.json");
const SESSIONS_FILE = path.join(DATA_DIR, "sessions.json");
const COOKIE = "lauwak_sid";
const SESSION_MS = 30 * 24 * 60 * 60 * 1000; // 30 days

function load(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return {};
  }
}
function save(file, obj) {
  fs.mkdirSync(DATA_DIR, { recursive: true });
  const tmp = file + ".tmp";
  fs.writeFileSync(tmp, JSON.stringify(obj, null, 2));
  fs.renameSync(tmp, file);
}

let users = load(USERS_FILE); // email -> { id, name, email, salt, hash, created }
let sessions = load(SESSIONS_FILE); // token -> { email, expires }

function hashPassword(password, salt) {
  return crypto.scryptSync(password, salt, 64).toString("hex");
}

function parseCookies(req) {
  const out = {};
  String(req.headers.cookie || "")
    .split(";")
    .forEach((p) => {
      const i = p.indexOf("=");
      if (i > 0) {
        let v = p.slice(i + 1).trim();
        try {
          v = decodeURIComponent(v);
        } catch {}
        out[p.slice(0, i).trim()] = v;
      }
    });
  return out;
}

function setCookie(req, res, value, maxAgeSec) {
  const secure =
    req.headers["x-forwarded-proto"] === "https" || req.socket.encrypted;
  res.setHeader(
    "Set-Cookie",
    `${COOKIE}=${encodeURIComponent(value)}; Path=/; HttpOnly; SameSite=Lax; Max-Age=${maxAgeSec}` +
      (secure ? "; Secure" : ""),
  );
}

function currentUser(req) {
  const token = parseCookies(req)[COOKIE];
  if (!token) return null;
  const s = sessions[token];
  if (!s || s.expires < Date.now()) return null;
  const u = users[s.email];
  return u ? { id: u.id, name: u.name, email: u.email } : null;
}

function pruneSessions() {
  const now = Date.now();
  let changed = false;
  for (const [t, s] of Object.entries(sessions))
    if (s.expires < now || !users[s.email]) {
      delete sessions[t];
      changed = true;
    }
  if (changed) save(SESSIONS_FILE, sessions);
}

function startSession(req, res, email) {
  pruneSessions();
  const token = crypto.randomBytes(32).toString("hex");
  sessions[token] = { email, expires: Date.now() + SESSION_MS };
  save(SESSIONS_FILE, sessions);
  setCookie(req, res, token, SESSION_MS / 1000);
}

const EMAIL_RE = /^[^\s@]{1,64}@[^\s@]{1,190}\.[^\s@]{2,}$/;

// Returns true if the request was an auth route (and has been answered).
async function handleAuth(req, res, url, { json, readBody, rateLimit }) {
  const p = url.pathname;
  if (!p.startsWith("/api/auth/")) return false;

  if (p === "/api/auth/me" && req.method === "GET") {
    const user = currentUser(req);
    json(res, user ? 200 : 401, user ? { user } : { error: "Not logged in" });
    return true;
  }

  if (req.method !== "POST") {
    json(res, 405, { error: "Method not allowed" });
    return true;
  }
  if (p !== "/api/auth/logout" && !rateLimit(req, res, 10, 60000)) return true;

  try {
    const body = p === "/api/auth/logout" ? {} : await readBody(req);
    const email = String(body.email || "").trim().toLowerCase().slice(0, 254);
    const password = String(body.password || "");

    if (p === "/api/auth/signup") {
      const name = String(body.name || "").trim().replace(/\s+/g, " ").slice(0, 60);
      if (!name) return json(res, 400, { error: "Please enter your name." }), true;
      if (!EMAIL_RE.test(email))
        return json(res, 400, { error: "Please enter a valid email address." }), true;
      if (password.length < 8 || password.length > 128)
        return json(res, 400, { error: "Password must be at least 8 characters." }), true;
      if (users[email])
        return json(res, 409, { error: "An account with this email already exists." }), true;
      const salt = crypto.randomBytes(16).toString("hex");
      users[email] = {
        id: crypto.randomUUID(),
        name,
        email,
        salt,
        hash: hashPassword(password, salt),
        created: Date.now(),
      };
      save(USERS_FILE, users);
      startSession(req, res, email);
      json(res, 201, { user: { id: users[email].id, name, email } });
      return true;
    }

    if (p === "/api/auth/login") {
      const u = users[email];
      // Hash even when the user is missing so timing doesn't reveal accounts.
      const salt = u ? u.salt : "0".repeat(32);
      const hash = Buffer.from(hashPassword(password, salt), "hex");
      const ok =
        u && crypto.timingSafeEqual(hash, Buffer.from(u.hash, "hex"));
      if (!ok)
        return json(res, 401, { error: "Wrong email or password." }), true;
      startSession(req, res, email);
      json(res, 200, { user: { id: u.id, name: u.name, email: u.email } });
      return true;
    }

    if (p === "/api/auth/logout") {
      const token = parseCookies(req)[COOKIE];
      if (token && sessions[token]) {
        delete sessions[token];
        save(SESSIONS_FILE, sessions);
      }
      setCookie(req, res, "", 0);
      json(res, 200, { ok: true });
      return true;
    }

    json(res, 404, { error: "Not found" });
  } catch (e) {
    json(res, e.status || 400, { error: e.message || "Bad request" });
  }
  return true;
}

module.exports = { handleAuth, currentUser };
